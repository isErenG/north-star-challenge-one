# Optional; local file organisation works without any external credentials.
GOOGLE_MAPS_API_KEY=
RESEND_API_KEY=
NOTIFY_FROM=
# HTTPS URL used in completion emails when deployed behind authentication.
PUBLIC_APP_URL=
# Listen address. Docker sets 0.0.0.0:8787; keep loopback for local runs.
ADDR=127.0.0.1:8787
# Go defaults to server/data when started with npm run dev.
# DATA_DIR=/absolute/path/to/private/job-data

# Mapbox public token (pk.*) for the results map view. Restrict it by URL in your Mapbox account.
MAPBOX_ACCESS_TOKEN=
