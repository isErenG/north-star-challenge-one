# Optional; local file organisation works without any external credentials.
GOOGLE_MAPS_API_KEY=
RESEND_API_KEY=
NOTIFY_FROM=
# HTTPS URL used in completion emails when deployed behind authentication.
PUBLIC_APP_URL=
# Listen address. Docker sets 0.0.0.0:8787; keep loopback for local runs.
ADDR=127.0.0.1:8787
# Go defaults to server/data when started with npm run dev.
# DATA_DIR=/absolute/path/to/private/job-data

# Mapbox public token (pk.*) for the results map view. Restrict it by URL in your Mapbox account.
MAPBOX_ACCESS_TOKEN=

# Real-world verification (all optional; a source without a key is skipped).
# OpenAI judge: reads collected evidence, never browses. Check the model name is current.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_COST_EUR=0.002
# Google Places (New) text search; ~0.03 EUR per call after the free tier.
GOOGLE_COST_EUR=0.03
# data.be API token (optional).
DATABE_TOKEN=
# Directory scraping is off by default because those sites forbid it. Opt in with e.g.
# ENRICH_DIRECTORIES=goldenpages,trendstop
ENRICH_DIRECTORIES=
# Default per-job budget shown on the upload screen.
ENRICH_DEFAULT_BUDGET_EUR=5
