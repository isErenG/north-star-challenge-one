{
  "name": "kbo-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "build:go": "go build -trimpath -ldflags=\"-s -w\" -o bin/kbo-review ./cmd/kbo-review",
    "build:all": "npm run build && npm run build:go",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "setup:go": "node scripts/setup-go.mjs",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests *.ts *.js *.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.3",
    "daisyui": "^5.0.0",
    "prettier": "^3.9.7",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "mapbox-gl": "^3.30.0"
  }
}
